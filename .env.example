# `python setup.py` を実行すると、このファイルは対話的に生成・更新されます。
# 手で書く場合は .env にコピーして埋めてください。

# ── Slack ──
# Bot User OAuth Token (Install App 画面)
SLACK_BOT_TOKEN=xoxb-xxxx
# App-Level Token / Socket Mode 用 (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-xxxx

# ── Google ──
# 以下2つは setup.py が自動で作成してここに書き込みます。
# 既存のスプレッドシート/フォルダを使いたい場合のみ手で指定してください。
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# OAuth2 の認証情報ファイル (通常は変更不要)
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_DRIVE_TOKEN_FILE=drive_token.json

# ── その他 ──
TIMEZONE=Asia/Tokyo
