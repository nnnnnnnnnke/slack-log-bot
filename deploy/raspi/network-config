# cloud-init network-config (netplan v2)
#
# 有線のみ。bot は外向き接続しかしないので待ち受けポートは不要だが、
# ヘッドレス機に SSH で入るため、アドレスは固定しておく。
#
# ★ addresses / routes / nameservers を自分のネットワークに書き換えること。
#   DHCP で構わないなら、下の ethernets を丸ごとこれに置き換える:
#
#     ethernets:
#       eth0:
#         dhcp4: true
#         optional: true
#
# wifis は書かない。SSID を埋めないまま残すと、存在しないアクセスポイントへ
# 延々と接続を試みる設定が有効なまま残る。無線を使うときだけ足す。
version: 2
ethernets:
  eth0:
    dhcp4: false
    dhcp6: false
    accept-ra: true
    addresses:
      - 192.168.1.50/24
    routes:
      - to: default
        via: 192.168.1.1
    nameservers:
      addresses: [192.168.1.1, 1.1.1.1]
    # ケーブル未接続でも起動を止めない（ヘッドレスで復旧できなくなるため）
    optional: true
